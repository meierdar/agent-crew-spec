#!/bin/sh
# ai-verify — Run executable acceptance criteria + DoD checks
#
# Usage:
#   ai-verify <story-file>              Run story + global checks
#   ai-verify <story-file> --story-only Run story checks only
#   ai-verify <story-file> --dod-only   Run global DoD checks only
#   ai-verify <story-file> --dry-run    Parse and show checks without running
#   ai-verify <story-file> --boundary   Check boundary violations only
#
# Exit codes:
#   0 = all checks passed
#   1 = one or more checks failed
#   2 = usage error

set -e

# --- Config ---
AI_DIR="${AI_DIR:-.ai}"
POC_DIR="$(cd "$(dirname "$0")/.." && pwd)"  # for PoC, use local dirs
CONVENTIONS_DIR="${POC_DIR}/conventions"
CHECKPOINT_DIR="${POC_DIR}/checkpoints"

# --- Colors (if terminal) ---
if [ -t 1 ]; then
    GREEN='\033[0;32m'
    RED='\033[0;31m'
    YELLOW='\033[0;33m'
    CYAN='\033[0;36m'
    DIM='\033[0;90m'
    BOLD='\033[1m'
    RESET='\033[0m'
else
    GREEN='' RED='' YELLOW='' CYAN='' DIM='' BOLD='' RESET=''
fi

# --- Counters (use temp file to survive subshells) ---
COUNTER_FILE=$(mktemp)
echo "0 0 0" > "$COUNTER_FILE"  # total failures skipped
trap 'rm -f "$COUNTER_FILE"' EXIT

read_counters() {
    read TOTAL FAILURES SKIPPED < "$COUNTER_FILE"
}

write_counters() {
    echo "$TOTAL $FAILURES $SKIPPED" > "$COUNTER_FILE"
}

inc_total() {
    read_counters
    TOTAL=$((TOTAL + 1))
    write_counters
}

inc_fail() {
    read_counters
    FAILURES=$((FAILURES + 1))
    write_counters
}

inc_skip() {
    read_counters
    SKIPPED=$((SKIPPED + 1))
    write_counters
}

# --- Usage ---
usage() {
    sed -n '2,/^$/s/^# //p' "$0"
    exit 2
}

# --- Helpers ---
pass() {
    inc_total
    printf "${GREEN}  PASS${RESET} %s\n" "$1"
}

fail() {
    inc_total
    inc_fail
    printf "${RED}  FAIL${RESET} %s\n" "$1"
}

skip() {
    inc_total
    inc_skip
    printf "${YELLOW}  SKIP${RESET} %s\n" "$1"
}

info() { printf "${CYAN}  INFO${RESET} %s\n" "$1"; }
header() { printf "\n${BOLD}%s${RESET}\n" "$1"; }

# --- Parse verify block from markdown ---
extract_verify_block() {
    _file="$1"
    _tag="$2"
    sed -n "/^\`\`\`${_tag}/,/^\`\`\`/p" "$_file" | sed '1d;$d'
}

# --- Run a single check line ---
run_check() {
    _line="$1"
    _dry_run="$2"

    # Skip empty lines and comments
    case "$_line" in
        ""|\#*) return 0 ;;
    esac

    # Parse the check type and arguments
    _cmd=$(echo "$_line" | awk '{print $1}')
    _args=$(echo "$_line" | cut -d' ' -f2-)

    if [ "$_dry_run" = "true" ]; then
        info "$_cmd $_args"
        return 0
    fi

    case "$_cmd" in

        FILE_EXISTS)
            if [ -e "$_args" ]; then
                pass "FILE_EXISTS $_args"
            else
                fail "FILE_EXISTS $_args (not found)"
            fi
            ;;

        FILE_NOT_EXISTS)
            if [ ! -e "$_args" ]; then
                pass "FILE_NOT_EXISTS $_args"
            else
                fail "FILE_NOT_EXISTS $_args (file exists but shouldn't)"
            fi
            ;;

        TEST)
            _test_cmd="$_args"
            if eval "$_test_cmd" > /dev/null 2>&1; then
                pass "TEST $_test_cmd"
            else
                fail "TEST $_test_cmd (non-zero exit)"
            fi
            ;;

        TEST_COUNT)
            _dir=$(echo "$_args" | awk '{print $1}')
            _op=$(echo "$_args" | awk '{print $2}')
            _expected=$(echo "$_args" | awk '{print $3}')
            if [ -d "$_dir" ]; then
                _count=$(grep -r "test\('" "$_dir" 2>/dev/null | wc -l)
                _count=$(echo "$_count" | tr -d ' ')
                case "$_op" in
                    ">=") [ "$_count" -ge "$_expected" ] && pass "TEST_COUNT $_dir: $_count $_op $_expected" || fail "TEST_COUNT $_dir: $_count $_op $_expected" ;;
                    "<=") [ "$_count" -le "$_expected" ] && pass "TEST_COUNT $_dir: $_count $_op $_expected" || fail "TEST_COUNT $_dir: $_count $_op $_expected" ;;
                    "="|"==") [ "$_count" -eq "$_expected" ] && pass "TEST_COUNT $_dir: $_count $_op $_expected" || fail "TEST_COUNT $_dir: $_count $_op $_expected" ;;
                    *) fail "TEST_COUNT $_dir: unknown operator $_op" ;;
                esac
            else
                fail "TEST_COUNT $_dir (directory not found)"
            fi
            ;;

        RUN)
            _run_cmd="$_args"
            if eval "$_run_cmd" > /dev/null 2>&1; then
                pass "RUN $_run_cmd"
            else
                fail "RUN $_run_cmd (non-zero exit)"
            fi
            ;;

        GREP)
            _target=$(echo "$_args" | awk '{print $1}')
            _rest=$(echo "$_args" | cut -d' ' -f2-)
            _pattern=$(echo "$_rest" | sed 's/ *--include=[^ ]*//')
            _include=$(echo "$_rest" | grep -o '\-\-include=[^ ]*' || true)
            _pattern=$(echo "$_pattern" | sed 's/^"//;s/"$//')

            if [ -d "$_target" ]; then
                if [ -n "$_include" ]; then
                    _result=$(grep -rlE "$_pattern" "$_target" $_include 2>/dev/null || true)
                else
                    _result=$(grep -rlE "$_pattern" "$_target" 2>/dev/null || true)
                fi
            elif [ -f "$_target" ]; then
                _result=$(grep -lE "$_pattern" "$_target" 2>/dev/null || true)
            else
                fail "GREP $_target (path not found)"
                return 0
            fi

            if [ -n "$_result" ]; then
                pass "GREP $_target \"$_pattern\""
            else
                fail "GREP $_target \"$_pattern\" (pattern not found)"
            fi
            ;;

        GREP_FAIL)
            _target=$(echo "$_args" | awk '{print $1}')
            _pattern=$(echo "$_args" | cut -d' ' -f2- | sed 's/^"//;s/"$//')

            if [ -d "$_target" ]; then
                _result=$(grep -rlE "$_pattern" "$_target" 2>/dev/null || true)
            elif [ -f "$_target" ]; then
                _result=$(grep -lE "$_pattern" "$_target" 2>/dev/null || true)
            else
                pass "GREP_FAIL $_target (path not found, so no matches)"
                return 0
            fi

            if [ -z "$_result" ]; then
                pass "GREP_FAIL $_target \"$_pattern\""
            else
                fail "GREP_FAIL $_target \"$_pattern\" (found in: $_result)"
            fi
            ;;

        *)
            skip "$_cmd $_args (unknown check type)"
            ;;
    esac
}

# --- Run all checks from a verify block ---
run_verify_block() {
    _block="$1"
    _dry="$2"

    # Write block to temp file, iterate line by line without subshell
    _block_file=$(mktemp)
    echo "$_block" > "$_block_file"

    while IFS= read -r _line; do
        run_check "$_line" "$_dry"
    done < "$_block_file"

    rm -f "$_block_file"
}

# --- Main ---

STORY_FILE=""
MODE="all"

# Parse args
while [ $# -gt 0 ]; do
    case "$1" in
        --story-only) MODE="story-only" ;;
        --dod-only) MODE="dod-only" ;;
        --dry-run) MODE="dry-run" ;;
        --boundary) MODE="boundary" ;;
        -h|--help) usage ;;
        *)
            if [ -z "$STORY_FILE" ]; then
                STORY_FILE="$1"
            else
                echo "Error: unexpected argument '$1'" >&2
                usage
            fi
            ;;
    esac
    shift
done

[ -z "$STORY_FILE" ] && usage

if [ ! -f "$STORY_FILE" ]; then
    echo "Error: story file not found: $STORY_FILE" >&2
    exit 2
fi

# Extract story ID for checkpoint
STORY_ID=$(grep '^id:' "$STORY_FILE" | head -1 | awk '{print $2}')
ROLE=$(grep '^assigned_role:' "$STORY_FILE" | head -1 | awk '{print $2}')
CHECKPOINT_FILE="${CHECKPOINT_DIR}/${STORY_ID}.checkpoint"

printf "${BOLD}ai-verify${RESET} — ${STORY_ID}\n"
printf "${DIM}Story: ${STORY_FILE}${RESET}\n"
printf "${DIM}Role:  ${ROLE}${RESET}\n"
printf "${DIM}Mode:  ${MODE}${RESET}\n"

_is_dry=$([ "$MODE" = "dry-run" ] && echo true || echo false)

# --- Story-specific checks ---
if [ "$MODE" != "dod-only" ] && [ "$MODE" != "boundary" ]; then
    _verify_block=$(extract_verify_block "$STORY_FILE" "verify")

    if [ -n "$_verify_block" ]; then
        header "Story Checks: ${STORY_ID}"
        run_verify_block "$_verify_block" "$_is_dry"
    else
        info "No verify block found in story"
    fi
fi

# --- Global DoD checks (from conventions) ---
if [ "$MODE" != "story-only" ] && [ "$MODE" != "boundary" ]; then
    _convention_file=""
    if [ -n "$ROLE" ] && [ -f "${CONVENTIONS_DIR}/${ROLE}.md" ]; then
        _convention_file="${CONVENTIONS_DIR}/${ROLE}.md"
    else
        for f in "${CONVENTIONS_DIR}"/*.md; do
            [ -f "$f" ] && _convention_file="$f" && break
        done
    fi

    if [ -n "$_convention_file" ] && [ -f "$_convention_file" ]; then
        _dod_block=$(extract_verify_block "$_convention_file" "verify-always")

        if [ -n "$_dod_block" ]; then
            header "DoD Checks (from $(basename "$_convention_file"))"
            run_verify_block "$_dod_block" "$_is_dry"
        fi
    else
        info "No convention file found for role: $ROLE"
    fi
fi

# --- Read final counters ---
read_counters

# --- Write checkpoint ---
if [ "$MODE" != "dry-run" ]; then
    _timestamp=$(date -u +%Y-%m-%dT%H:%M:%SZ)
    mkdir -p "$(dirname "$CHECKPOINT_FILE")"
    if [ "$FAILURES" -gt 0 ]; then
        echo "${_timestamp} VERIFY_FAIL ${FAILURES}/${TOTAL} checks failed" >> "$CHECKPOINT_FILE"
    else
        echo "${_timestamp} VERIFY_PASS ${TOTAL}/${TOTAL} checks passed" >> "$CHECKPOINT_FILE"
    fi
fi

# --- Summary ---
_passed=$((TOTAL - FAILURES - SKIPPED))
printf "\n${BOLD}────────────────────────────────────${RESET}\n"
printf "Total: %d  " "$TOTAL"
printf "${GREEN}Passed: %d${RESET}  " "$_passed"
printf "${RED}Failed: %d${RESET}  " "$FAILURES"
printf "${YELLOW}Skipped: %d${RESET}\n" "$SKIPPED"

if [ "$FAILURES" -gt 0 ]; then
    printf "${RED}${BOLD}VERIFICATION FAILED${RESET}\n"
    exit 1
else
    printf "${GREEN}${BOLD}ALL CHECKS PASSED${RESET}\n"
    exit 0
fi
